.venv/
.venv-test/
*.py[cod]
.pytest_cache/
pytest-cache-files-*/
.coverage
data/
!src/gradient_starvation/data/
!src/gradient_starvation/data/**
results/
tmp/
.DS_Store
# Keep bytecode caches ignored even inside the explicitly un-ignored
# ``src/gradient_starvation/data`` package.  Git applies the last matching rule,
# so this must follow the negations above.
**/__pycache__/

# Local LaTeX build products and ad-hoc Overleaf bundles. Canonical PDFs are
# already tracked explicitly and remain tracked despite these rules.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
/overleaf_paper.zip
/paper/overleaf_paper.zip
/paper/submission.pdf
